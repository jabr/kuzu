-DATASET CSV tinysnb

--

-CASE JaccardSimilarityBasic
-LOAD_DYNAMIC_EXTENSION algo
-STATEMENT CALL PROJECT_GRAPH('Graph', ['person', 'organisation'], ['meets', 'knows', 'studyAt', 'workAt']);
---- ok
-STATEMENT CALL JACCARD_SIMILARITY('Graph') RETURN node1, node2, similarity;
